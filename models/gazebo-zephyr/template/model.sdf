<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="zephyr_with_ardupilot">
    <pose>0 0 0 0 0 3.141593</pose>

    <include>
      <uri>model://gazebo-zephyr/base</uri>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <!-- Main wing lift -->
    <plugin name="wing_lift" filename="libLiftDragPlugin.so">
      <a0>0.13</a0>
      <cla>3.7</cla>
      <cda>0.06417112299</cda>
      <cma>-0.05</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0 -0.1 0</cp>
      <area>0.50</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>zephyr::wing</link_name>
    </plugin>

    <!-- Left elevon lift/control -->
    <plugin name="left_elevon_lift" filename="libLiftDragPlugin.so">
      <a0>0.15</a0>
      <cla>6.8</cla>
      <cda>0.06417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.6391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.7 0.20 0</cp>
      <area>0.10</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>zephyr::wing</link_name>
      <control_joint_name>zephyr::flap_left_joint</control_joint_name>
      <control_joint_rad_to_cl>-5.0</control_joint_rad_to_cl>
    </plugin>

    <!-- Right elevon lift/control -->
    <plugin name="right_elevon_lift" filename="libLiftDragPlugin.so">
      <a0>0.15</a0>
      <cla>6.8</cla>
      <cda>0.06417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.6391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.7 0.20 0</cp>
      <area>0.10</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>zephyr::wing</link_name>
      <control_joint_name>zephyr::flap_right_joint</control_joint_name>
      <control_joint_rad_to_cl>-5.0</control_joint_rad_to_cl>
    </plugin>

    <!-- Rudder / vertical stabilizer lift -->
    <plugin name="left_rudder_lift" filename="libLiftDragPlugin.so">
      <a0>0.0</a0>
      <cla>4.752798721</cla>
      <cda>0.6417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.76 0.30 0.025</cp>
      <area>0.12</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>1 0 0</upward>
      <link_name>zephyr::wing</link_name>
    </plugin>

    <plugin name="right_rudder_lift" filename="libLiftDragPlugin.so">
      <a0>0.0</a0>
      <cla>4.752798721</cla>
      <cda>0.6417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.76 0.30 0.025</cp>
      <area>0.12</area>
      <air_density>1.2041</air_density>
      <forward>0 -1 0</forward>
      <upward>1 0 0</upward>
      <link_name>zephyr::wing</link_name>
    </plugin>

    <!-- Propeller blade aerodynamics -->
    <plugin name="propeller_blade_1_lift" filename="libLiftDragPlugin.so">
      <a0>0.30</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.02</area>
      <air_density>1.2041</air_density>
      <cp>0 0 0.074205</cp>
      <forward>-1 0 0</forward>
      <upward>0 -1 0</upward>
      <link_name>zephyr::propeller</link_name>
    </plugin>

    <plugin name="propeller_blade_2_lift" filename="libLiftDragPlugin.so">
      <a0>0.30</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.02</area>
      <air_density>1.2041</air_density>
      <cp>0 0 -0.074205</cp>
      <forward>1 0 0</forward>
      <upward>0 -1 0</upward>
      <link_name>zephyr::propeller</link_name>
    </plugin>
   <link name="skid_pad">
      <pose>0.0 -0.07 -0.02 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
        <inertia>
          <ixx>0.0043137104</ixx>
          <ixy>0</ixy>
          <iyy>0.00387382402</iyy>
          <ixz>0</ixz>
          <iyz>0</iyz>
          <izz>0.00809845106</izz>
        </inertia>
      </inertial>
      <!-- <visual name="skid_pad">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.5 1.0 .05</size>
          </box>
        </geometry>
      </visual> -->

      <collision name="skid_pad">
        <!-- <pose>0 -0.07 0.025 0 0 0</pose> -->
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.0 0.5 .05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>1</kd>
              <min_depth>0.01</min_depth>
              <max_vel>1.0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode>
              <!--
              <slip2>20</slip2>
              -->
              <mu>0.3</mu>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="skid_pad_joint" type="fixed">
      <parent>zephyr::wing</parent>
      <child>skid_pad</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
    </joint>
    
    <!-- ArduPilot bridge -->
    <plugin name="arduplane_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>

      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 1.57079632</gazeboXYZToNED>

      <imuName>zephyr::imu_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>

      <!-- SERVO3: throttle -->
      <control channel="2">
        <jointName>zephyr::propeller_joint</jointName>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <type>VELOCITY</type>
        <p_gain>0.5</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>0.0</cmd_min>
      </control>

      <!-- SERVO1: left elevon -->
      <control channel="0">
        <jointName>zephyr::flap_left_joint</jointName>
        <multiplier>-1</multiplier>
        <offset>-0.5</offset>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
      </control>

      <!-- SERVO2: right elevon -->
      <control channel="1">
        <jointName>zephyr::flap_right_joint</jointName>
        <multiplier>-1</multiplier>
        <offset>-0.5</offset>
        <type>POSITION</type>
        <p_gain>10.0</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
      </control>
    </plugin>
  </model>
</sdf>